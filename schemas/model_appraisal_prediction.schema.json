{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emoai.dev/schemas/model_appraisal_prediction.schema.json",
  "title": "EmoAI Generic Appraisal Prediction v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_id",
    "valence_level",
    "mixed_valence",
    "intensity_level",
    "relevance_level",
    "novelty_level",
    "certainty_level",
    "controllability_level",
    "temporal_orientation",
    "primary_target",
    "primary_event",
    "primary_event_level",
    "secondary_event_1",
    "secondary_event_1_level",
    "secondary_event_2",
    "secondary_event_2_level",
    "current_evidence_quote",
    "alternative_interpretation",
    "memory_action",
    "salience_level",
    "persistence_allowed",
    "detail_allowed",
    "source_turn_ids",
    "target_reference_keys",
    "pending_confirmation",
    "privacy_class",
    "redaction_required",
    "risk_label_primary",
    "risk_label_secondary",
    "annotation_note"
  ],
  "properties": {
    "conversation_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "integer", "minimum": 1 },
    "valence_level": { "type": ["integer", "null"], "minimum": -2, "maximum": 2 },
    "mixed_valence": { "enum": ["yes", "no", "unknown"] },
    "intensity_level": { "$ref": "#/$defs/level04" },
    "relevance_level": { "$ref": "#/$defs/level04" },
    "novelty_level": { "$ref": "#/$defs/level04" },
    "certainty_level": { "$ref": "#/$defs/level04" },
    "controllability_level": { "$ref": "#/$defs/level04" },
    "temporal_orientation": { "enum": ["past", "present", "future", "mixed", "unknown"] },
    "primary_target": { "$ref": "#/$defs/target" },
    "causal_agent": { "$ref": "#/$defs/actor" },
    "relationship_target": { "$ref": "#/$defs/actor" },
    "primary_event": { "$ref": "#/$defs/event" },
    "primary_event_level": { "$ref": "#/$defs/level03" },
    "secondary_event_1": { "oneOf": [{ "$ref": "#/$defs/event" }, { "type": "null" }] },
    "secondary_event_1_level": { "$ref": "#/$defs/nullableLevel03" },
    "secondary_event_2": { "oneOf": [{ "$ref": "#/$defs/event" }, { "type": "null" }] },
    "secondary_event_2_level": { "$ref": "#/$defs/nullableLevel03" },
    "current_evidence_quote": { "type": ["string", "null"] },
    "alternative_interpretation": { "type": ["string", "null"] },
    "memory_action": { "enum": ["none", "update_stats", "create_episode", "extend_episode", "reconsolidate", "resolve_episode", "merge_pattern", "delete", "unknown"] },
    "salience_level": { "$ref": "#/$defs/level04" },
    "persistence_allowed": { "enum": ["yes", "no", "unknown"] },
    "detail_allowed": { "enum": ["none", "summary", "expanded", "central_rich", "unknown"] },
    "source_turn_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "target_reference_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pending_confirmation": { "enum": ["yes", "no", "unknown"] },
    "privacy_class": { "enum": ["none", "personal", "sensitive", "credential", "third_party", "unknown"] },
    "redaction_required": { "enum": ["yes", "no", "unknown"] },
    "risk_label_primary": { "$ref": "#/$defs/risk" },
    "risk_label_secondary": { "oneOf": [{ "$ref": "#/$defs/risk" }, { "type": "null" }] },
    "annotation_note": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "level04": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "level03": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "nullableLevel03": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "target": { "enum": ["agent", "assistant", "npc", "user", "third_party", "shared_task", "none", "unknown"] },
    "actor": { "enum": ["agent", "assistant", "npc", "user", "third_party", "shared_task", "environment", "system", "none", "unknown"] },
    "event": { "enum": ["reward", "threat", "rejection", "attachment", "goal_progress", "goal_block", "care_signal", "repair_signal", "dominance", "novelty_event", "ambiguity"] },
    "risk": { "enum": ["none", "privacy_design_risk", "credential_exposure", "credential_use_request", "privacy_leak", "third_party_privacy", "self_harm", "violence", "illegal_action", "emotional_dependency", "manipulation", "harassment", "medical_risk", "financial_risk", "other"] }
  }
}
